DATABASE_URL="postgresql+asyncpg://kullanici:sifre@localhost:5432/veritabani_adi"

JWT_SECRET="change-me-in-prod"
JWT_ALGORITHM="HS256"

ACCESS_TOKEN_EXPIRE_MINUTES="120"
BASE_DOMAIN="behtechlabs.com"
ENVIRONMENT="development"

DAILY_APPOINTMENT_LIMIT="0"  # müşteri başına günlük en fazla randevu; 0 = sınırsız
OTP_EXPIRATION_SECONDS="120"

BACKUP_RETENTION_DAYS="7"

EVOLUTION_API_BASE_URL="http://localhost:8080"
EVOLUTION_API_KEY="your-evolution-api-key"
# EVOLUTION_INSTANCE_NAME artık kullanılmıyor: her dükkân kendi WhatsApp instance'ını panelden bağlar.

# Sadece development: sabit OTP kodu (boş bırakın = rastgele)
OTP_FIXED_CODE=

# Billing bildirimleri (opsiyonel)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true


# Dükkân WhatsApp bağlantı olayları (Evolution -> backend). Yerelde Docker içinden host: host.docker.internal
EVOLUTION_WEBHOOK_URL=http://host.docker.internal:8001/api/webhooks/evolution
EVOLUTION_WEBHOOK_SECRET=uzun-rastgele-bir-deger
