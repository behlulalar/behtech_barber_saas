# /etc/nginx/snippets/berber-security.conf — YALNIZCA berber sitesinin location'larında include edilir.
add_header Strict-Transport-Security "max-age=31536000" always;
add_header X-Content-Type-Options "nosniff" always;
add_header X-Frame-Options "DENY" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
# CSP: yalnızca kendi kaynağımız; Google Fonts; görseller data:/blob:; index.html'deki tek satır tema betiği karma ile izinli.
add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-{{CSP_SCRIPT_HASH}}'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" always;
